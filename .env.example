# --- Interviewer model -------------------------------------------------------
# Local (default): Llama served by Ollama. Install Ollama, then: ollama pull llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Hosted (optional): any OpenAI-compatible endpoint serving a Llama model,
# e.g. https://api.groq.com/openai/v1 or https://api.together.xyz/v1
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=llama-3.1-8b-instant

# --- Code execution sandbox ---------------------------------------------------
# Candidate code runs in a locked-down Docker container (no network, capped CPU/memory/pids).
# Pull the image once with: npm run sandbox:pull
SANDBOX_IMAGE=python:3.11-alpine

# Development only: if Docker is unavailable, run code in a local Python subprocess
# with a timeout. This is NOT a security boundary — never enable it on a shared server.
VOXORA_ALLOW_UNSANDBOXED=0
